{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/artist/ray-of-sunshine",
      "destination": "/artist/melanie-dyson-o2jf",
      "permanent": false
    },
    {
      "source": "/cart/cart",
      "destination": "/cart",
      "permanent": false
    },
    {
      "source": "/marketplace/marketplace",
      "destination": "/store",
      "permanent": false
    },
    {
      "source": "/digital/digital",
      "destination": "/radio",
      "permanent": false
    },
    {
      "source": "/radio/radio",
      "destination": "/radio",
      "permanent": false
    },
    {
      "source": "/support/support",
      "destination": "/support",
      "permanent": false
    },
    {
      "source": "/privacy/privacy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms/terms",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/faq/faq",
      "destination": "/faq",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/signup",
      "destination": "/signup/signup"
    }
  ],
  "functions": {
    "src/app/(app)/media/[...path]/route.ts": {
      "includeFiles": "public/**"
    }
  }
}
